#
# source bashrc
#[ -f ~/.config/bash/bashrc ] && source ~/.config/bash/bashrc
#

#
# Envierment
#
export EDITOR="mircro"
export VISUAL="micro"
export TERMINAL="kitty"
export LANG="en_US.UTF-8"

export HISTFILESIZE=10000 
export HISTSIZE=500
export HISTTIMEFORMAT="%F %T"
export HISTCONTROL=erasedups:ignoredups:ignorespace

shopt -s checkwinsize
shopt -s histappend
PROMT_COMMAND='history -a'

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export PATH="$HOME/.local/bin:$PATH"

export PREFIX="$HOME/.local"

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

if [ -f /etc/bashrc ]; then
    . /etc/bashrc   # --> Read /etc/bashrc, if present.
fi

#
# load aliases
#
[ -f ~/.config/bash/aliases ] && source ~/.config/bash/aliases

#
# Export my theme
#
export THEME=$HOME/.config/bash/mytheme
        if [[ -f $THEME ]]; then
        export DEFAULT_USER=`whoami`
        source $THEME
fi

#
# Blesh for autosuggestions and syntaxis highliting
#
[ -f ~/.local/share/blesh/ble.sh ] && source ~/.local/share/blesh/ble.sh
